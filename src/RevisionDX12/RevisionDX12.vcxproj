if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSWaterAsk -D RDX_RT=1 -D RDX_RT_ASK=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtAskPS.h" -Vn GSolidPassRtAskPS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSSludgeMirror -D RDX_RT=1 -D RDX_RT_HOST=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtHostSludgeMirrorPS.h" -Vn GSolidPassRtHostSludgeMirrorPS "%(FullPath)"
if errorlevel 1 exit /b 1
