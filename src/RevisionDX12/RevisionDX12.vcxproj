if errorlevel 1 exit /b 1</Command>
      <AdditionalInputs>$(ProjectDir)RenderLimits.h;$(ProjectDir)RayListSlots.hlsli;$(ProjectDir)RtTables.hlsli;$(ProjectDir)RtLampLight.hlsli;$(ProjectDir)..\..\scripts\embed-text.ps1</AdditionalInputs>
      <Outputs>$(IntDir)SolidPassText.h;$(IntDir)SolidPassRtVS.h;$(IntDir)SolidPassRtHS.h;$(IntDir)SolidPassRtDS.h;$(IntDir)SolidPassRtMarkPS.h;$(IntDir)SolidPassRtMarkPSLit.h;$(IntDir)SolidPassRtFlashVS.h;$(IntDir)SolidPassRtMainVS.h;$(IntDir)SolidPassRtAskGlassMirrorPS.h;$(IntDir)SolidPassRtHostGlassMirrorPS.h;$(IntDir)SolidPassRtHostGlassMirrorPSLit.h;$(IntDir)SolidPassRtAskWetMirrorPS.h;$(IntDir)SolidPassRtHostWetMirrorPS.h;$(IntDir)SolidPassRtHostWetMirrorPSLit.h;$(IntDir)SolidPassRtHostPS.h;$(IntDir)SolidPassRtHostPSLit.h;$(IntDir)SolidPassRtAskPS.h;$(IntDir)SolidPassRtHostSludgeMirrorPS.h;$(IntDir)SolidPassRtHostSludgeMirrorPSLit.h;$(IntDir)SolidPassRtAskSludgeMirrorPS.h;$(IntDir)SolidPassRtHostSplashPS.h;$(IntDir)SolidPassRtHostSplashPSLit.h;$(IntDir)SolidPassRtAskSplashPS.h;$(IntDir)SolidPassRtAskMarkPS.h;$(IntDir)SolidPassRtHostPaneKeepPS.h;$(IntDir)SolidPassRtAskPaneKeepPS.h</Outputs>
