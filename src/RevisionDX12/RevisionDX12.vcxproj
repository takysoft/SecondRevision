  <!--
    SecondRevision - Direct3D 12 render device for Deus Ex: Revision (engine 1.112fm).

    Build constraints are dictated by the game, not by taste (see docs/spec-01 section 6):
      - Win32 only: the game is a 32-bit process
      - packing   : NOT set globally. The SDK needs 4-byte packing but the
                    Windows/D3D12 headers require the default; Pch.h wraps only
                    the engine includes in a pack region. See Pch.h.
      - /Zc:wchar_t- : the engine's TCHAR handling predates native wchar_t
    Changing any of these produces a DLL that loads and then corrupts memory.
  -->

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

