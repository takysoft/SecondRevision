  <ItemGroup>
    <!-- The wet floors' late reflection pass (WetReflect.hlsl): its text goes into the DLL, compiled at run time
         (WetReflect.cpp). -->
    <CustomBuild Include="WetReflect.hlsl">
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\..\scripts\embed-text.ps1" -Out "$(IntDir)WetReflectText.h" -Pairs "GWetReflectText=%(FullPath)"
if errorlevel 1 exit /b 1</Command>
      <AdditionalInputs>$(ProjectDir)..\..\scripts\embed-text.ps1</AdditionalInputs>
      <Outputs>$(IntDir)WetReflectText.h</Outputs>
      <Message>Shader: WetReflect.hlsl (its text)</Message>
    </CustomBuild>
    <!-- The own body in the panes where no rays run (MirrorBody.hlsl): its text goes into the DLL, compiled at run time
         (MirrorBody.cpp). -->
    <CustomBuild Include="MirrorBody.hlsl">
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\..\scripts\embed-text.ps1" -Out "$(IntDir)MirrorBodyText.h" -Pairs "GMirrorBodyText=%(FullPath)"
if errorlevel 1 exit /b 1</Command>
      <AdditionalInputs>$(ProjectDir)..\..\scripts\embed-text.ps1</AdditionalInputs>
      <Outputs>$(IntDir)MirrorBodyText.h</Outputs>
      <Message>Shader: MirrorBody.hlsl (its text)</Message>
    </CustomBuild>
    <!-- The mirror probe gathered from the picture (MirrorProbe.hlsl): its passes' text goes into the DLL, compiled at run
         time like every other pass that needs no shader model 6 (MirrorProbe.cpp). -->
    <CustomBuild Include="MirrorProbe.hlsl">
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\..\scripts\embed-text.ps1" -Out "$(IntDir)MirrorProbeText.h" -Pairs "GMirrorProbeText=%(FullPath)"
if errorlevel 1 exit /b 1</Command>
      <AdditionalInputs>$(ProjectDir)..\..\scripts\embed-text.ps1</AdditionalInputs>
      <Outputs>$(IntDir)MirrorProbeText.h</Outputs>
      <Message>Shader: MirrorProbe.hlsl (its text)</Message>
    </CustomBuild>
    <!-- Reflections=RTLow's pass over the rays' list (RaySparse.hlsl): DXIL by dxc, as the geometry pass's builds on rays,
         whose list it reads by the same text (RaySparse.cpp). -->
    <CustomBuild Include="RaySparse.hlsl">
      <Command>"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T cs_6_0 -E SparseCS -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)RaySparseCS.h" -Vn GRaySparseCS "%(FullPath)"
if errorlevel 1 exit /b 1</Command>
      <AdditionalInputs>$(ProjectDir)RenderLimits.h;$(ProjectDir)RayListSlots.hlsli</AdditionalInputs>
      <Outputs>$(IntDir)RaySparseCS.h</Outputs>
      <Message>Shader: RaySparse.hlsl (DXIL)</Message>
    </CustomBuild>
    <!-- The shadow factor (ShadowFactor.hlsl, and the statements it includes): its text goes into the DLL for the maps'
         factor, compiled at run time like every other pass (FinalPass.cpp). The rays' factor and occlusion of the same
         source (RDX_RT=1) are the 64-bit host's to build (Host64.vcxproj). -->
    <CustomBuild Include="ShadowFactor.hlsl">
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\..\scripts\embed-text.ps1" -Out "$(IntDir)ShadowFactorText.h" -Pairs "GShadowFactorText=%(FullPath);GShadowFactorSurfaceText=$(ProjectDir)ShadowFactorSurface.hlsli"
if errorlevel 1 exit /b 1</Command>
      <AdditionalInputs>$(ProjectDir)ShadowFactorSurface.hlsli;$(ProjectDir)RenderLimits.h;$(ProjectDir)..\..\scripts\embed-text.ps1</AdditionalInputs>
      <Outputs>$(IntDir)ShadowFactorText.h</Outputs>
      <Message>Shader: ShadowFactor.hlsl (its text)</Message>
    </CustomBuild>
    <!-- The geometry pass's shaders: one source for two builds (SolidPass.hlsl). Its text goes into the DLL, compiled at run
         time like every other pass (SolidPass.cpp); and dxc makes the stages of the runs on rays of it (RDX_RT=1), as
         DXIL - the run-time compiler (FXC) knows no shader model 6, and the SDK's dxc signs what it builds, with the
         dxil.dll beside it: nothing is shipped with the game for it. The stages before the pixel shader, the water's
         first go over a run, and for each run on rays - the water's, the sludge mirror layer's, the splashes', the
         glass mirror layer's, the panes' - the pixel shader that writes its rays down for the 64-bit host
         (RDX_RT_ASK=1) and the one that reads the host's answers (RDX_RT_HOST=1). -->
    <CustomBuild Include="SolidPass.hlsl">
      <Command>powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\..\scripts\embed-text.ps1" -Out "$(IntDir)SolidPassText.h" -Pairs "GSolidPassText=%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T vs_6_5 -E VSWater -D RDX_RT=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtVS.h" -Vn GSolidPassRtVS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T hs_6_5 -E HSWater -D RDX_RT=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtHS.h" -Vn GSolidPassRtHS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ds_6_5 -E DSWater -D RDX_RT=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtDS.h" -Vn GSolidPassRtDS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSWaterMark -D RDX_RT=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtMarkPS.h" -Vn GSolidPassRtMarkPS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSWaterMarkLit -D RDX_RT=1 -D RDX_LIGHT_TARGET=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtMarkPSLit.h" -Vn GSolidPassRtMarkPSLit "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T vs_6_5 -E FlashVS -D RDX_RT=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtFlashVS.h" -Vn GSolidPassRtFlashVS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T vs_6_5 -E VSMain -D RDX_RT=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtMainVS.h" -Vn GSolidPassRtMainVS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSGlassMirrorAsk -D RDX_RT=1 -D RDX_RT_ASK=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtAskGlassMirrorPS.h" -Vn GSolidPassRtAskGlassMirrorPS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSGlassMirror -D RDX_RT=1 -D RDX_RT_HOST=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtHostGlassMirrorPS.h" -Vn GSolidPassRtHostGlassMirrorPS "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSGlassMirrorLit -D RDX_RT=1 -D RDX_RT_HOST=1 -D RDX_LIGHT_TARGET=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtHostGlassMirrorPSLit.h" -Vn GSolidPassRtHostGlassMirrorPSLit "%(FullPath)"
if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSWetMirrorAsk -D RDX_RT=1 -D RDX_RT_ASK=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtAskWetMirrorPS.h" -Vn GSolidPassRtAskWetMirrorPS "%(FullPath)"
