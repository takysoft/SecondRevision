if errorlevel 1 exit /b 1
"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSWetMirrorLit -D RDX_RT=1 -D RDX_RT_HOST=1 -D RDX_LIGHT_TARGET=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtHostWetMirrorPSLit.h" -Vn GSolidPassRtHostWetMirrorPSLit "%(FullPath)"
