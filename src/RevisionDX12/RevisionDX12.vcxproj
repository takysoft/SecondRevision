"$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxc.exe" -nologo -T ps_6_5 -E PSPaneKeep -D RDX_RT=1 -D RDX_RT_HOST=1 -O3 -Qstrip_debug -Qstrip_reflect -Fh "$(IntDir)SolidPassRtHostPaneKeepPS.h" -Vn GSolidPassRtHostPaneKeepPS "%(FullPath)"
