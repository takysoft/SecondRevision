<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    LevelRoundCheck: the renderer's rounding of the level (src\RevisionDX12\LevelRound.h) run on a level's polygons
    written out by scripts\level_round_check.py, with no game and no graphics card - and what must hold of it checked.
    The rounding is engine-independent, so this needs nothing past the CRT and Windows' own headers.
  -->

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{0620BB9B-87E7-4265-99C9-123FAFB3A53C}</ProjectGuid>
    <RootNamespace>LevelRoundCheck</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v145</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)..\..\build\levelroundcheck\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\..\build\obj\levelroundcheck\</IntDir>
    <TargetName>LevelRoundCheck</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\src\RevisionDX12;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <TreatWarningAsError>true</TreatWarningAsError>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="LevelRoundCheck.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\src\RevisionDX12\LevelRound.h" />
    <ClInclude Include="..\..\src\RevisionDX12\MeshRound.h" />
    <ClInclude Include="..\..\src\RevisionDX12\Spherify.h" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
